# Copy to .env and fill in. Never commit the result.

# Azure app registration (portal.azure.com -> App registrations)
CLIENT_ID=                     # Overview -> "Application (client) ID"
CLIENT_SECRET=                 # Certificates & secrets -> the "Value" column,
                               # NOT the "Secret ID". Shown once at creation.
REDIRECT_URI=http://localhost:5000/callback

# Flask session signing. Anyone with this can forge a session for any user.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Anthropic. Use a workspace-scoped key with a spend limit.
ANTHROPIC_API_KEY=

# Access control. Comma-separated. Without this NOBODY can sign in —
# the gate is fail-closed by design.
ADMIN_EMAIL=

# Optional: approval notifications via Resend. Unset means requests are
# only visible at /admin.
NOTIFY_EMAIL=
RESEND_API_KEY=
MAIL_FROM=
PUBLIC_BASE_URL=

# Optional: per-account spend ceiling for the calendar month, in dollars.
# Unset means no limit, which is right for a single-operator instance.
# Set it before approving anyone else: an approved account can otherwise
# cost you ~$6.65 by syncing a large mailbox, and Detective bills per round.
# Admins are exempt. Example: USER_SPEND_LIMIT_USD=5
USER_SPEND_LIMIT_USD=

# Optional: defaults to ./catalog.db. On a host with a mounted disk, point
# it at that disk or the catalog is lost on every deploy.
DB_PATH=

# Optional: how often the app snapshots the database itself, in hours.
# Defaults to 24; set to 0 to turn scheduled backups off and take them by hand
# with backup.py. Snapshots land beside DB_PATH, so on a hosted instance that
# means the mounted disk.
BACKUP_INTERVAL_HOURS=

# Optional: how many snapshots to keep. Defaults to 7.
BACKUP_KEEP=
